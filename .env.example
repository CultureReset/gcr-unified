# gcr-unified settings. Vite reads VITE_* at build time; .env.production holds
# the public values for the live site. None of these are secrets — everything
# here ends up in the browser. Never put a database or service key here.

# gcr-api-clean base URL (the only data source). Required.
VITE_API_BASE=
# Supabase project URL — only for public storage image paths and the unused
# supabaseAuth helper. The anon key, if ever needed, goes in VITE_SUPABASE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# 'browse' or 'swipe'
VITE_DEFAULT_MODE=browse
# The one "text to join" number used by loyalty links.
VITE_SMS_NUMBER=

# ── Public site identity ─────────────────────────────────────────────────
# Brand shown in titles, headers and schema.org (blank = not shown).
VITE_BRAND_NAME=
# This site's origin, e.g. https://example.com — canonical, share and results links.
VITE_SITE_URL=
# Region line on the directory and concierge, e.g. "Town · Town · Town".
VITE_REGION_LABEL=
# Platform credit on business and link pages ("Powered by …").
VITE_PLATFORM_NAME=
# Name of the web concierge.
VITE_CONCIERGE_NAME=
# Example questions for the concierge, separated by |
VITE_CONCIERGE_STARTERS=
# The concierge phone number, if visitors can text it.
VITE_CONCIERGE_NUMBER=
# ISO currency for prices that do not carry their own, e.g. USD.
VITE_CURRENCY=

# ── Build only (scripts/prerender.mjs) ───────────────────────────────────
# Defaults to VITE_SITE_URL.
SITE_BASE_URL=
# Cap how many businesses are prerendered (quick test runs).
PRERENDER_LIMIT=
# 1 = also prerender each business's public modules (one request per business).
PRERENDER_MODULES=
